# Environment files with secrets
config/.env
.env
.env.*
*.env.local
!.env.example

# Vault data
vault-data/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# Docker volumes
.docker/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
coverage/
*.log

# Build artifacts
dist/
build/
*.egg
ui/admin/dist/
docs/site/

# Kubernetes secrets (encrypted ok, raw not ok)
*-secrets.yaml
!*-sealed-secrets.yaml

# Local Docker data volumes
postgres-data/
redis-data/
prometheus-data/
grafana-data/
vault-logs/

# Temporary files
*.tmp
*.temp
/tmp/
scratchpad/

# OS files
.DS_Store
Thumbs.db
*.bak

# Credentials (never commit)
*.pem
*.key
credentials.json
service-account.json

# Terraform state and secrets
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform/environments/demo.tfvars
terraform/environments/staging.tfvars
terraform/environments/prod.tfvars
terraform/environments/secrets.auto.tfvars
terraform/environments/demo-ephemeral/terraform.tfvars
.claude/

# License signing private keys — NEVER commit. Live in ~/.scutum/ on the issuer's laptop.
*license-private*.pem
*.private.pem

# Override: allow the license PUBLIC key (matches *.pem above). It's
# intentionally bundled so admin-api can validate signed license JWTs.
!config/license-public.pem

# Override: allow .env.example templates (matches .env.* above). Templates
# are public; only the actual .env (with secrets) stays gitignored.
!config/.env.example
!config/.env.release.example
