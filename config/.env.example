# =============================================================================
# Scutum Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your environment
# Works on: macOS, Linux, Windows (Docker Desktop)
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development  # development | staging | production

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable platform features
FEATURE_ADMIN_UI=true
FEATURE_AGENT_GATEWAY=true
FEATURE_SEMANTIC_CACHE=false
FEATURE_WORKFLOW_ENGINE=false
FEATURE_POLICY_ROUTER=false
FEATURE_OBSERVABILITY=true
FEATURE_LOCAL_MODELS=false        # Ollama integration
FEATURE_GPU_STUB=true             # Show helpful errors when Ollama not running

# -----------------------------------------------------------------------------
# SSL/TLS Configuration
# -----------------------------------------------------------------------------
ENABLE_SSL=false
SSL_CERT_PATH=./certs/localhost.pem
SSL_KEY_PATH=./certs/localhost-key.pem

# -----------------------------------------------------------------------------
# LiteLLM Configuration
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=$LITELLM_KEY  # CHANGE IN PRODUCTION
LITELLM_PORT=4000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm           # CHANGE IN PRODUCTION
POSTGRES_DB=litellm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# -----------------------------------------------------------------------------
# Admin Configuration
# -----------------------------------------------------------------------------
ADMIN_API_PORT=8086
ADMIN_UI_PORT=5173
LANDING_UI_PORT=9999
DECK_UI_PORT=6002
JWT_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_ENDPOINT=http://otel-collector:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
GRAFANA_ADMIN_PASSWORD=admin       # CHANGE IN PRODUCTION
JAEGER_PORT=16686

# -----------------------------------------------------------------------------
# AI Provider API Keys (Optional - configure as needed)
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=
# OR for Vertex AI:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# VERTEX_PROJECT=your-gcp-project
# VERTEX_LOCATION=us-central1

# xAI (Grok)
XAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com
AZURE_API_VERSION=2025-01-01-preview

# -----------------------------------------------------------------------------
# Local Models (Ollama)
# -----------------------------------------------------------------------------
# Ollama runs on host, Docker connects via:
# - Mac/Windows: host.docker.internal:11434
# - Linux: 172.17.0.1:11434 (or use host network mode)
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434

# -----------------------------------------------------------------------------
# Resource Limits (for production)
# -----------------------------------------------------------------------------
LITELLM_MEMORY_LIMIT=2g
LITELLM_CPU_LIMIT=2
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=512m

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------
# External ports (change if conflicts)
EXTERNAL_HTTP_PORT=80
EXTERNAL_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Internal Service Authentication
# -----------------------------------------------------------------------------
INTERNAL_SERVICE_KEY=change-this-to-a-random-string

# -----------------------------------------------------------------------------
# License (paste the JWT we issued you on first activation; admin-api persists
# it to the `licenses` table after that, so this is needed only on cold-boot)
# -----------------------------------------------------------------------------
# Customers: set this to the Ed25519-signed JWT you received from Scutum.
# Without it, admin-api boots in unlicensed mode and the UI prompts to activate.
# After first successful boot, the license is in the DB and this var is fallback only.
LICENSE_KEY=
# Override only if you've moved the bundled public key (almost no one needs this).
# LICENSE_PUBLIC_KEY_PATH=/app/config/license-public.pem

# -----------------------------------------------------------------------------
# Guardrails
# -----------------------------------------------------------------------------
ENABLE_GUARDRAILS=false

# -----------------------------------------------------------------------------
# Agent Gateway Keys (Optional)
# -----------------------------------------------------------------------------
BRAVE_API_KEY=
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Budget Webhook Alerting (Optional)
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALERT_RECIPIENTS=

# -----------------------------------------------------------------------------
# SRE Agent (Optional, profile=sre)
# -----------------------------------------------------------------------------
# Dedicated LiteLLM key for SRE agent audit attribution (defaults to LITELLM_MASTER_KEY)
SRE_AGENT_API_KEY=
# Reasoning model the SRE agent uses to propose remediations.
# Must be defined in config/litellm/config.yaml.
SRE_AGENT_MODEL=claude-sonnet-4-6
# v1 always routes through human-in-loop. Flip to true in v2 to enable auto-execution
# of low-risk actions; v1 ignores this beyond logging.
SRE_AUTO_APPROVE=false
# Risk score (0-100) above which an action requires human approval (used in v2).
SRE_RISK_THRESHOLD=40
# URL for admin-api event_publisher to dispatch sre_workflow channel events.
SRE_AGENT_URL=http://sre-agent:8092
# Public-facing URL the SRE agent uses when generating incident links in notifications.
ADMIN_UI_URL=http://localhost:5173

# =============================================================================
# scutum.dev MARKETING SURFACES — DO NOT SET ON CUSTOMER DEPLOYS
# =============================================================================
# Everything below this line is consumed only by services in the `marketing`
# Docker Compose profile (landing-ui, landing-backend, deck-ui, playground-ui).
# Customer deploys MUST omit these — they only matter for the scutum.dev VM.
# Run customer stacks with `make up` (no marketing profile).
# Run scutum.dev stack with `make up-marketing`.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Landing Page Book-a-Demo (scutum.dev only)
# -----------------------------------------------------------------------------
# Cal.com REST API integration. Get the API key from Cal.com → Settings → Developer.
# CALCOM_EVENT_TYPE_ID is the numeric id of the event type used for demos.
# When unset, the form still persists requests to DB; sales follows up manually.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
# Base URL for Cal.com API (override only if self-hosting Cal.com).
CALCOM_BASE_URL=https://api.cal.com/v1

# Internal "new demo request" email destination — recipient of founder alerts.
# Should be a real Workspace alias (default: demo@scutum.dev).
# When unset, no email is sent — leads still appear in the admin UI Leads page.
DEMO_INBOX=demo@scutum.dev
# Sender address. Must be a verified address in your transactional provider
# (Resend / Postmark) AND a real alias in your Workspace so replies don't bounce.
# Default uses hello@ since "noreply@" isn't typically set up as an alias.
DEMO_FROM=hello@scutum.dev
# Reply-To header on outgoing alerts. Where customer replies route to.
DEMO_REPLY_TO=hello@scutum.dev

# Per-IP rate limit on /api/demo-request (defense against form abuse).
DEMO_RATE_LIMIT_MAX=5
DEMO_RATE_LIMIT_WINDOW_S=3600

LANDING_BACKEND_PORT=8093

# -----------------------------------------------------------------------------
# Hosted free-trial funnel (scutum.dev/try) — Fly.io + Cloudflare integration.
# -----------------------------------------------------------------------------
# Powers the /try signup flow: Cloudflare Turnstile bot-check, admin-api
# trial-signup router, trial-provisioner that creates per-user Fly apps.
# All optional — when unset, /try renders but signup will return 503.

# Cloudflare Turnstile keys. Site key is public (embedded in /try HTML);
# secret key is server-side (used by admin-api to validate the token).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Fly.io API token for the org that hosts trial machines.
# Get from: https://fly.io/user/personal_access_tokens (org-scoped token).
FLY_API_TOKEN=
FLY_ORG_SLUG=

# Cloudflare DNS API token + zone id for trial-{id}.trial.scutum.dev records.
# Token needs zone:DNS:edit on the scutum.dev zone only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Base domain trial subdomains hang off (CNAME target → Fly app).
TRIAL_BASE_DOMAIN=trial.scutum.dev

# Trial lifecycle knobs.
TRIAL_LIFETIME_DAYS=30
TRIAL_REMINDER_DAYS_BEFORE_EXPIRY=3
