# ===== REQUIRED for MVP =====

# Your Scutum gateway. Production: https://scutum.dev/v1
# Local dev against local stack: http://localhost:4000/v1
SCUTUM_API_URL=https://scutum.dev/v1

# Bearer token sent to the gateway. Use a chat-scoped key (issued from the
# Admin UI → API Keys), NOT the master key — lets you cap monthly spend
# on chat traffic specifically and revoke without affecting other clients.
SCUTUM_API_KEY=

# LiteLLM model alias to call. `scutum-research` is defined in
# config/litellm/config.yaml and resolves to Claude Sonnet by default.
SCUTUM_DEFAULT_MODEL=scutum-research

# Search provider for the search-augmented retrieval step.
# Tavily: tavily.com (purpose-built for AI search; 1000 free queries/mo)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Public site identity (browser-exposed)
NEXT_PUBLIC_APP_URL=https://chat.scutum.dev
NEXT_PUBLIC_SITE_NAME=Scutum Research


# ===== OPTIONAL — turn on as needed =====

# Auth (Clerk). Comment out for anonymous-only MVP.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Persistence (chat thread history). Vercel Postgres or Supabase URL.
# POSTGRES_URL=

# Rate limiting. Required before going public so a stray scrape doesn't
# burn a month of LLM credits in an afternoon.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
ANON_RATE_LIMIT_PER_HOUR=10
USER_RATE_LIMIT_PER_HOUR=100

# Feature flags
ENABLE_PRO_SEARCH=false       # multi-agent (planner+searchers+writer); needs workflow-engine
ENABLE_DEEP_RESEARCH=false    # Temporal-backed long-running mode; needs a2a-runtime
