# =============================================================================
# Scutum — release environment template
# =============================================================================
# Copy this file to `.env` and fill in the values. The installer does this
# automatically on first run; you only need to edit it once.
# =============================================================================

# -----------------------------------------------------------------------------
# License (REQUIRED)
# -----------------------------------------------------------------------------
# The signed JWT we emailed you. Without it, Scutum runs in unlicensed mode
# and the Admin Console will prompt for activation. Get one from hello@scutum.dev.
LICENSE_KEY=

# Scutum release version. Pin this to the version you tested with.
SCUTUM_VERSION=0.1.0

# -----------------------------------------------------------------------------
# Secrets (REQUIRED — generate fresh values for production)
# -----------------------------------------------------------------------------
# Master API key used by your applications when calling the Scutum proxy at
# port 4000. The variable name is `LITELLM_MASTER_KEY` for legacy compatibility.
LITELLM_MASTER_KEY=sk-CHANGE-ME-openssl-rand-hex-32

# Signs admin-console session tokens.
JWT_SECRET_KEY=CHANGE-ME-openssl-rand-hex-32

# Auth between internal services (cost-predictor, budget-webhook, sre-agent).
INTERNAL_SERVICE_KEY=CHANGE-ME-openssl-rand-hex-32

# Postgres credentials.
POSTGRES_USER=scutum
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-hex-16
POSTGRES_DB=scutum

# -----------------------------------------------------------------------------
# Provider API keys (configure the providers you want enabled)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2025-01-01-preview

# -----------------------------------------------------------------------------
# Ports (change only if you have conflicts on the host)
# -----------------------------------------------------------------------------
LITELLM_PORT=4000
ADMIN_API_PORT=8086
ADMIN_UI_PORT=5173
DOCS_SITE_PORT=8089

# -----------------------------------------------------------------------------
# Resource limits (tune for your hardware)
# -----------------------------------------------------------------------------
LITELLM_MEMORY_LIMIT=2g
REDIS_MEMORY_LIMIT=512mb

# -----------------------------------------------------------------------------
# Optional integrations (only relevant under `--profile finops`)
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# -----------------------------------------------------------------------------
# Optional SRE agent settings (only relevant under `--profile sre`)
# -----------------------------------------------------------------------------
SRE_AGENT_MODEL=claude-sonnet-4-6
SRE_AUTO_APPROVE=false
SRE_RISK_THRESHOLD=40
